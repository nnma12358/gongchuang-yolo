# ============================================================
# Jetson Nano · YOLO 目标检测容器（视觉三层之“检测层”）
# ------------------------------------------------------------
# 基镜像：NVIDIA L4T r32.7.1（JetPack 4.6.1，aarch64，Python 3.6）
# 职责：只做目标检测（YOLOv8 ONNX，OpenCV DNN / 可选 ONNX Runtime）
# 端口：8101
#
# 模型来源：工创yolo 项目
#   python train_detection.py --config config/sorting_competition.yaml --epochs 150
#   python export_models.py   --config config/sorting_competition.yaml --imgsz 960
#   产物 → 本仓库 models/detect/goods_yolov8n_640_fp32.onnx（compose 只读挂载 /app/models）
#
# 构建（项目根目录）：
#   docker build -f deploy/jetson/Dockerfile.yolo -t sort-yolo:jetson .
# ============================================================
# 基础镜像可用 --build-arg / .env 里的 BASE_IMAGE 换成国内代理，例如：
#   docker.m.daocloud.io/nvcr.io/nvidia/l4t-base:r32.7.1
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-base:r32.7.1
FROM ${BASE_IMAGE}

# 非交互安装：不加这行，apt 会在 tzdata 等处弹 debconf 交互界面，构建就卡住了
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
# 必须设 UTF-8 locale：容器默认是 POSIX/ASCII，pip 读带中文注释的
# requirements.txt 会抛 UnicodeDecodeError 直接中断构建
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN set -e; \
    if [ -f /etc/apt/sources.list ]; then \
        cp /etc/apt/sources.list /etc/apt/sources.list.bak; \
        sed -i -e 's@http://ports.ubuntu.com/@http://mirrors.aliyun.com/@g' \
               -e 's@http://archive.ubuntu.com/@http://mirrors.aliyun.com/@g' \
               -e 's@http://security.ubuntu.com/@http://mirrors.aliyun.com/@g' \
               /etc/apt/sources.list || true; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev build-essential \
        python3-numpy python3-opencv python3-pil \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m pip install --no-cache-dir --upgrade \
        -i https://mirrors.aliyun.com/pypi/simple/ "pip<22" "setuptools<60" wheel \
    && rm -rf /root/.cache/pip/*


# numpy 锁死 1.19.2：pip 上 1.19.5 及更新的 aarch64 轮子是按 ARMv8.2 编的，
# 在 Jetson Nano(Tegra X1, ARMv8.0) 上会 "Illegal instruction" 直接崩。
# 1.19.2 实测可用，且满足 onnxruntime 的依赖要求。
RUN pip3 install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
        "numpy==1.19.2" && rm -rf /root/.cache/pip/*

COPY deploy/jetson/requirements-yolo.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
        -r /app/requirements.txt && rm -rf /root/.cache/pip/*

# ONNX 推理用 onnxruntime：
#   · apt 的 OpenCV 3.2 没有 dnn 模块（readNetFromONNX 需 >=3.3），pip 的 opencv 轮子
#     在 Tegra X1 上 SIGILL 用不了 —— 所以图像编解码用 apt 的 cv2 3.2，推理交给 ORT；
#   · onnxruntime 的 aarch64 轮子在这块板子上实测可用（检测前向 ~750ms/帧，CPU）；
#   · --no-deps：ORT 声明需要 numpy>=1.19.5，但那个版本会 SIGILL，我们锁 1.19.2。
RUN pip3 install --no-cache-dir --no-deps -i https://mirrors.aliyun.com/pypi/simple/ \
        "onnxruntime==1.9.0" && rm -rf /root/.cache/pip/*


# ---- TensorRT（仅本镜像需要）：跑 .engine 加速推理 ----
# 说明：容器里跑 TRT 需要三样东西，这里都用 apt 装好（不需要宿主 nvidia runtime）：
#   python3-libnvinfer = TRT 运行时 + python 绑定（7.1.3，与宿主 trtexec 同版本）
#   cuda-cudart-10-2   = libcudart（显存管理，代码用 ctypes 调它，不依赖 pycuda）
#   libcuda.so.1（驱动）与 GPU 设备节点由 compose 挂载/privileged 提供
ARG NVIDIA_L4T_VER=r32.5
RUN set -eux; \
    echo "deb [trusted=yes] https://repo.download.nvidia.com/jetson/common ${NVIDIA_L4T_VER} main" \
        > /etc/apt/sources.list.d/nvidia-l4t.list; \
    echo "deb [trusted=yes] https://repo.download.nvidia.com/jetson/t210 ${NVIDIA_L4T_VER} main" \
        >> /etc/apt/sources.list.d/nvidia-l4t.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        python3-libnvinfer cuda-cudart-10-2 cuda-nvrtc-10-2 libcublas10 libcudnn8; \
    rm -rf /var/lib/apt/lists/*; \
    python3 -c "import tensorrt; print('TensorRT', tensorrt.__version__)" || \
        echo "WARN: tensorrt 导入失败（缺少的设备侧库由 compose 挂载提供，运行时再验证）"

# 仅检测服务（模型通过 /app/models 挂载进来，便于换模型不重建镜像）
COPY server/yolo_server.py /app/

ENV PORT=8101
ENV MODEL_PATH=/app/models/detect/goods_yolov8n_640_fp32.onnx
ENV CLASSES_JSON=/app/models/detect/classes.json
# 必须与训练 imgsz 一致（本模型 640；现场确实漏小目标再试 960，属未验证配置）
ENV IMGSZ=640
ENV CONF_THRES=0.35
ENV IOU_THRES=0.45
# ort=ONNX Runtime（本镜像已装，用它做 ONNX 推理）；
# opencv=OpenCV DNN（需 OpenCV>=3.3，本镜像的 apt 版是 3.2，仅作兜底）
ENV ENGINE=ort
ENV OMP_NUM_THREADS=4
ENV OPENBLAS_NUM_THREADS=4

EXPOSE 8101

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost:8101/health || exit 1

CMD ["python3", "yolo_server.py"]
